{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ada.invalid/schemas/memory.schema.json",
  "title": "ADA Memory Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "memory_id", "kind", "content", "source_kind", "source_id", "source_digest", "namespace", "tags", "metadata", "status", "created_at", "updated_at", "expires_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "memory_id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["working", "episodic", "semantic", "procedural"]},
    "content": {"type": "object", "minProperties": 1},
    "source_kind": {"enum": ["perception", "representation", "user", "system", "imported"]},
    "source_id": {"type": "string", "minLength": 1},
    "source_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "namespace": {"type": "string", "minLength": 1},
    "tags": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "metadata": {"type": "object"},
    "status": {"enum": ["active", "archived", "deleted"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
